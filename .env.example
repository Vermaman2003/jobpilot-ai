# ========================================================
# JobPilot AI — Environment Configuration Template
# ========================================================

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase PostgreSQL & Auth (Optional - Local in-memory/disk store works out of the box)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Provider Configuration (Optional - Deterministic non-AI fallback operates by default)
AI_PROVIDER="gemini" # Options: "gemini" | "deterministic"
GEMINI_API_KEY=""    # Obtain free at https://aistudio.google.com

# Gmail API OAuth Integration (Optional - Mock testing dataset provided out-of-the-box)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Scheduled Searches Automation
CRON_SECRET="jobpilot_cron_local_secret_key_12345"
